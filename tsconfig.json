{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "target": "es2020",
    "declaration": true,                              
    "declarationMap": true, 
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "strict": true
  },
  "include": ["src", "index.ts"],
  "exclude": ["tests", "dist", "docs", "node_modules"]
}